{
  "title": "G4 Platform \u2014 Golden Signals",
  "uid": "g4-golden-signals",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "title": "Kong",
      "type": "row",
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "title": "Kong RPS",
      "type": "timeseries",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(kong_http_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Kong P95 Latency",
      "type": "timeseries",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(kong_latency_bucket[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Kong 5xx Error Rate",
      "type": "timeseries",
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(kong_http_requests_total{status=~'5..'}[5m])) / sum(rate(kong_http_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
