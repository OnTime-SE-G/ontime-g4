{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://example.com/schemas/eta-prediction-response.schema.json",
	"title": "EtaPredictionResponse",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"route_id": {
			"type": "string"
		},
		"vehicle_id": {
			"type": "string"
		},
		"halt_id": {
			"type": "string"
		},
		"estimated_arrival_time": {
			"type": "string",
			"format": "date-time"
		}
	},
	"required": [
		"route_id",
		"vehicle_id",
		"halt_id",
		"estimated_arrival_time"
	]
}

