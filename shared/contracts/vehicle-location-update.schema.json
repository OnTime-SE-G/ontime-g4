{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://example.com/schemas/vehicle-location-update.schema.json",
	"title": "VehicleLocationUpdate",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"vehicle_id": {
			"type": "string"
		},
		"latitude": {
			"type": "number",
			"minimum": -90,
			"maximum": 90
		},
		"longitude": {
			"type": "number",
			"minimum": -180,
			"maximum": 180
		},
		"timestamp": {
			"type": "string",
			"format": "date-time"
		}
	},
	"required": [
		"vehicle_id",
		"latitude",
		"longitude",
		"timestamp"
	]
}


